# ============ 敏感信息（绝不入库）============
# api/.env 里有真实的 LLM Key，只提交 .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*.json
*service-account*.json

# ============ 运行数据 ============
# SQLite 数据库、配图、日志、数据库备份都落在这里，体积大且属于本地数据
api/storage/*
!api/storage/.gitkeep
.logs/

# 界面截图属于本地走查产物：36 张约 13 MB，二进制进 git 会让历史越滚越大
docs/screenshots/

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ============ Node / 前端构建产物 ============
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
.tanstack/
.wrangler/
*.local

# ============ 日志 ============
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ============ 系统 / 编辑器 ============
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*~
