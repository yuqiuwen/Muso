APP_ENV=development

# 服务
APP_NAME=muso
FASTAPI_TITLE=Muso API
FASTAPI_VERSION=0.1.0
FASTAPI_SUMMARY=妙作 Muso 内容创作工作台
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SQLite（相对 api/ 目录）
DB_MAIN_URL=sqlite+aiosqlite:///./storage/muso.db

# Redis / Celery。留空时 Celery 走 eager 模式（任务同步执行），本地无需起 Redis。
REDIS_CACHE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# 大模型。留空则 AI 生成走「本地模板渲染」降级路径，不发起网络请求。
MUSO_LLM_MODEL=
MUSO_LLM_API_KEY=
MUSO_LLM_BASE_URL=
